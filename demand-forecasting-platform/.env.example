# Database Configuration
POSTGRES_DB=forecasting
POSTGRES_USER=forecasting_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://forecasting_user:change_me_in_production@localhost:5432/forecasting

# Redis Configuration
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# API Keys for Data Sources
OPENWEATHER_API_KEY=your_openweather_api_key_here
FRED_API_KEY=your_fred_api_key_here
NOAA_API_KEY=your_noaa_api_key_here

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=demand-forecasting

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development  # development, staging, production

# API Gateway Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Data Ingestion Schedule (cron format)
INGESTION_SCHEDULE=0 */6 * * *  # Every 6 hours
WEATHER_UPDATE_INTERVAL=3600  # 1 hour in seconds
ECONOMIC_UPDATE_INTERVAL=86400  # 24 hours in seconds

# Model Configuration
DEFAULT_FORECAST_HORIZON=90  # days
DEFAULT_CONFIDENCE_LEVEL=0.95
MODEL_RETRAIN_FREQUENCY=7  # days
FEATURE_STORE_CACHE_TTL=3600  # 1 hour

# Performance Tuning
MAX_CONCURRENT_FORECASTS=10
CACHE_PREDICTIONS_TTL=1800  # 30 minutes
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Monitoring & Observability (Optional)
SENTRY_DSN=your_sentry_dsn_here
DATADOG_API_KEY=your_datadog_key_here
PROMETHEUS_ENABLED=false
GRAFANA_PASSWORD=admin

# Security
JWT_SECRET_KEY=generate_a_secure_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Multi-tenancy
ENABLE_MULTI_TENANCY=true
DEFAULT_TENANT=demo

# Feature Flags
ENABLE_LSTM_MODEL=false  # Enable LSTM in ensemble (slower but more accurate)
ENABLE_REAL_TIME_UPDATES=false  # Kafka streaming (Phase 3)
ENABLE_AUTO_REBALANCING=true  # Automatic inventory rebalancing
