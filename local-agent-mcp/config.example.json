{
  "lmstudio": {
    "base_url": "http://localhost:1234/v1",
    "model": "nemotron-nano-30b",
    "max_tokens": 2048,
    "temperature": 0.3,
    "timeout_seconds": 120
  },
  "searxng": {
    "base_url": "http://localhost:8080",
    "enabled": false,
    "max_results": 5
  },
  "mcp_servers": {
    "web": {
      "command": "python",
      "args": ["mcp_servers/web_server/server.py"],
      "transport": "stdio"
    },
    "rag": {
      "command": "python",
      "args": ["mcp_servers/rag_server/server.py"],
      "transport": "stdio"
    }
  },
  "cache": {
    "directory": "data/cache",
    "max_age_hours": 24
  },
  "faiss": {
    "index_path": "data/faiss/index.bin",
    "metadata_path": "data/faiss/metadata.jsonl",
    "dimension": 384,
    "top_k": 5
  },
  "retrieval_triggers": [
    "latest", "new developments", "what's new", "today",
    "this week", "update", "recent", "current", "now",
    "breaking", "just released"
  ]
}
