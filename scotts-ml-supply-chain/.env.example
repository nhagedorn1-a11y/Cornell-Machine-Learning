# API Keys Configuration
# Copy this file to .env and add your actual API keys

# OpenAI GPT-4 (Optional - for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional - for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Weather API Keys (Optional - for real weather data)
OPENWEATHER_API_KEY=your_openweather_key_here
WEATHERAPI_KEY=your_weatherapi_key_here

# Database Connection (Optional - if using real database)
DATABASE_URL=postgresql://user:password@localhost:5432/supply_chain

# Deployment Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME_BASE=light

# Security
SECRET_KEY=your_secret_key_for_session_management
